[Unit]
Description=Ayla Power Monitor (heartbeat + Telegram, single main.py)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ayla_power_monitor
ExecStart=/home/pi/ayla_power_monitor/.venv/bin/python /home/pi/ayla_power_monitor/main.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
